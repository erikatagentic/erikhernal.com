---
import Notebook from '../layouts/Notebook.astro';
import Receipt from '../components/Receipt.astro';
import Slip from '../components/Slip.astro';
import receipts from '../data/receipts.json';
import clay from '../data/clay-snapshot.json';
import { formatDate, formatDateTimeUTC } from '../lib/dates';
import { BUILT_PAGE } from '../lib/pages';
import { loadShowcases } from '../lib/showcases.mjs';
import savedShowcases from '../data/showcases.json';

const firstReceipt = receipts[0];
const nf = new Intl.NumberFormat('en-US');
const snapshotText = formatDateTimeUTC(clay.snapshot_at);
const { repos: showcases } = await loadShowcases({ fallback: savedShowcases });

const stats = [
  { value: nf.format(clay.tables.since), label: `tables built since ${formatDate(clay.since)}` },
  { value: nf.format(clay.audiences.alphaforge), label: 'cohort audiences' },
  { value: nf.format(clay.audiences.company_records_total), label: 'company records live' },
  {
    value: nf.format(Math.round(clay.credits_balance)),
    label: `credits left on ${formatDate(clay.snapshot_at)}`,
  },
];
---

<Notebook
  title="How this notebook is made | Erik Hernal"
  description="How Erik Hernal's portfolio was built, where its numbers come from, and what the receipts on each case page check."
  page={BUILT_PAGE}
>
  <article class="built">
    <h1 class="built-title">How this notebook is made</h1>
    <div class="built-prose">
      <p>
        I built this site on Nov 25, 2026, with Claude Code and OpenAI's Codex doing most of the
        typing. It replaces two older portfolios of mine, so the first job was reading every claim
        on both and keeping only the ones I could point to a file for. The ones I couldn't source
        got cut.
      </p>
      <p>
        The four case studies are the same write-ups that ran on my last site. Every number in them
        was checked against the file it came from before it went live, and those files are taped in
        on each page.
      </p>
    </div>

    <section class="built-section" aria-labelledby="receipts-h">
      <h2 id="receipts-h">The receipts</h2>
      <p class="built-measure">
        Each cold email on the case pages carries a receipt. It says whether the address you'd reply
        to can actually take mail, checked through DNS, plus a live mail server handshake when the
        network lets one through (the receipt says when it didn't), plus a word
        count and a copy check. A script in a private repo runs those checks and saves the result
        here, so nothing on this public site holds a key.
      </p>
      {
        firstReceipt && (
          <div class="built-receipt">
            <Receipt receipt={firstReceipt} showMethod tilt="right" />
          </div>
        )
      }
    </section>

    <section class="built-section" aria-labelledby="clay-h">
      <h2 id="clay-h">Four weeks in Clay, read back through its API</h2>
      <p class="built-measure">
        This panel is a read-only pass over my Clay workspace, taken during the AlphaForge program
        the case studies came from. No Clay key touches this page.
      </p>
      <Slip tilt="left" class="clay-panel">
        <dl class="clay-stats">
          {
            stats.map((s) => (
              <div class="clay-stat">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="clay-sub">Tables built in that window</h3>
        <ol class="clay-tables">
          {
            clay.tables.named.map((t) => (
              <li>
                <time datetime={t.createdAt}>{formatDate(t.createdAt, { year: false })}</time>
                <span>{t.name}</span>
              </li>
            ))
          }
        </ol>
        <p class="clay-method">
          Method: {clay.method}. Snapshot taken <time datetime={clay.snapshot_at}>{snapshotText}</time>.
        </p>
      </Slip>
    </section>

    <section class="built-section" aria-labelledby="run-h">
      <h2 id="run-h">Something you can run</h2>
      <p class="built-measure">
        Everything else here is a record of work that already happened. This one is live: put a
        domain into <a href="https://heyagentic.ai/forge">heyagentic.ai/forge</a> and it researches
        the company and writes the cold email that company should be getting.
      </p>
      {
        showcases.length > 0 && (
          <>
            <p class="built-measure">
              And a few you can run on your own machine. Each one is a public repo, and its README
              gets it going.
            </p>
            <ul class="showcase-list">
              {showcases.map((r) => (
                <li>
                  <a href={r.url}>{r.name}</a>
                  {r.description && <span>{r.description}</span>}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>

    <p class="actions built-back"><a href="/">Back to the index</a></p>
  </article>
</Notebook>

<style is:global>
  .built-title {
    max-width: 20ch;
  }

  .built-prose {
    max-width: 64ch;
    margin-top: 24px;
  }

  .built-prose p:first-child {
    font-size: 21px;
    color: var(--ink-soft);
  }

  .built-section {
    margin-top: 96px;
  }

  .built-section > h2 {
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }

  .built-measure {
    max-width: 64ch;
  }

  .built-receipt {
    max-width: 460px;
    margin-top: 40px;
  }

  .clay-panel {
    max-width: 820px;
    margin-top: 40px;
  }

  .clay-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 24px;
    margin: 0;
  }

  .clay-stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }

  .clay-stat dd {
    margin: 0;
    font: 600 34px/1 var(--serif);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .clay-stat dt {
    font: 500 13px/1.3 var(--narrow);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .clay-sub {
    margin: 28px 0 8px;
    font: 700 13px/1.3 var(--narrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .clay-tables {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .clay-tables li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 5px 0;
    border-bottom: 1px dotted var(--grid-strong);
    font-size: 14px;
  }

  .clay-tables time {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .clay-tables span {
    overflow-wrap: anywhere;
  }

  .clay-method {
    margin: 14px 0 0;
    font: 400 11.5px/1.6 var(--mono);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .showcase-list {
    max-width: 64ch;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .showcase-list li {
    display: grid;
    grid-template-columns: minmax(0, 18ch) minmax(0, 1fr);
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px dotted var(--grid-strong);
  }

  .showcase-list a {
    font-family: var(--mono);
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .showcase-list span {
    color: var(--ink-soft);
  }

  .built-back {
    margin-top: 96px;
  }

  @media (max-width: 900px) {
    .clay-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .showcase-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .built-prose p:first-child {
      font-size: 18px;
    }

    .built-section,
    .built-back {
      margin-top: 72px;
    }

    .clay-stat dd {
      font-size: 28px;
    }
  }
</style>
