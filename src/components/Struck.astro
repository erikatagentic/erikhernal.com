---
interface Props {
  was: string;
  now: string;
  label: string;
  size?: 'lg' | 'sm';
}

const { was, now, label, size = 'lg' } = Astro.props;
---

<p class:list={['struck', `struck--${size}`]}>
  <s class="was"
    ><span class="sr-only">First reported as </span>{was}<svg
      class="strike"
      viewBox="0 0 100 20"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      ><path
        class="ink ink-hair"
        d="M-1 15.6 C 7 14.8, 15 14.6, 24 13.7 C 33 12.8, 41 12.9, 49 12.4 C 55 12, 59 10.6, 66 9.1 C 75 7.3, 85 6.9, 95 5.6 C 101 4.8, 105 4.6, 109 3.2"
      ></path><path
        class="ink ink-body"
        d="M3 14.9 C 11 14.1, 19 13.9, 28 13 C 36 12.3, 43 12.4, 50 11.9 C 56 11.4, 61 9.9, 68 8.5 C 77 6.9, 87 6.4, 97 5.1"
      ></path><path
        class="ink ink-press"
        d="M7 14.5 C 14 13.9, 21 13.6, 29 12.9 C 34 12.5, 38 12.5, 42 12.3"
      ></path><path
        class="ink ink-press ink-press-late"
        d="M64 9.2 C 70 8, 76 7.1, 83 6.5"
      ></path><path
        class="ink ink-tail"
        d="M96 5.3 C 100 4.7, 103 4.3, 107 3.6"
      ></path></svg
    ></s
  >
  <span class="now"><span class="sr-only">, corrected to </span>{now}</span>
  <span class="lbl">{label}</span>
</p>

<style>
  .struck {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 22px;
    margin: 22px 0 0;
    font-variant-numeric: tabular-nums;
  }

  .was {
    position: relative;
    display: inline-block;
    font: 600 64px/1 var(--serif);
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  /* the pen stroke: overlapping passes so the line tapers at both ends, presses
     harder near the start and again after it changes direction partway, then
     runs a little past the figure, the way a quick ballpoint strike does */
  .strike {
    position: absolute;
    left: -0.1em;
    top: 26%;
    width: calc(100% + 0.16em);
    height: 0.5em;
    overflow: visible;
    pointer-events: none;
  }

  .ink {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    /* the stroke keeps its width in screen pixels, so the dash is measured in
       pixels too: 1200px is longer than any figure this line will cross */
    stroke-dasharray: 1200px 1200px;
    stroke-dashoffset: 0;
  }

  .ink-hair {
    stroke-width: 1.4px;
    opacity: 0.85;
  }

  .ink-body {
    stroke-width: 3.2px;
    opacity: 0.92;
  }

  .ink-press {
    stroke-width: 4.6px;
    opacity: 0.5;
  }

  .ink-press-late {
    stroke-width: 3.8px;
    opacity: 0.4;
  }

  .ink-tail {
    stroke-width: 1px;
    opacity: 0.7;
  }

  :global(html.strike-anim) .ink {
    stroke-dashoffset: 1200px;
  }

  :global(html.strike-anim) .struck:global(.is-drawn) .ink {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 450ms var(--ease-out-expo);
  }

  :global(html.strike-anim) .struck:global(.is-drawn) .ink-body {
    transition-delay: 30ms;
  }

  :global(html.strike-anim) .struck:global(.is-drawn) .ink-press {
    transition-delay: 50ms;
  }

  :global(html.strike-anim) .struck:global(.is-drawn) .ink-press-late {
    transition-delay: 140ms;
  }

  :global(html.strike-anim) .struck:global(.is-drawn) .ink-tail {
    transition-delay: 220ms;
  }

  .now {
    font: 600 96px/1 var(--serif);
    letter-spacing: -0.02em;
    color: var(--red);
    white-space: nowrap;
  }

  .lbl {
    max-width: 16ch;
    font: 400 30px/1.05 var(--pen);
    color: var(--red);
  }

  .struck--sm {
    gap: 4px 14px;
    margin-top: 12px;
  }

  .struck--sm .was {
    font-size: 24px;
  }

  /* small figures get a taller, wider box so the same wobble and overshoot
     still read at 24px instead of flattening into a ruled line */
  .struck--sm .strike {
    left: -0.12em;
    top: 14%;
    width: calc(100% + 0.12em);
    height: 0.82em;
  }

  .struck--sm .ink-hair {
    stroke-width: 1px;
  }

  .struck--sm .ink-body {
    stroke-width: 1.9px;
  }

  .struck--sm .ink-press {
    stroke-width: 2.6px;
  }

  .struck--sm .ink-press-late {
    stroke-width: 2.2px;
  }

  .struck--sm .ink-tail {
    stroke-width: 0.8px;
  }

  .struck--sm .now {
    font-size: 34px;
    letter-spacing: 0;
  }

  .struck--sm .lbl {
    flex-basis: 100%;
    max-width: none;
    font-size: 24px;
    color: var(--ink-soft);
  }

  /* on paper every strike is drawn, whatever the screen state was */
  @media print {
    :global(html) .ink,
    :global(html.strike-anim) .ink,
    :global(html.strike-anim) .struck .ink {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) .ink,
    :global(html.strike-anim) .ink {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .was {
      font-size: 44px;
    }

    .now {
      font-size: 68px;
    }

    .lbl {
      flex-basis: 100%;
      max-width: 20ch;
      font-size: 28px;
    }

    .struck--sm .was {
      font-size: 24px;
    }

    .struck--sm .now {
      font-size: 34px;
    }

    .struck--sm .lbl {
      font-size: 24px;
      max-width: none;
    }
  }
</style>
